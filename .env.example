# Copia este archivo a .env y completa los valores reales.
# .env NUNCA se commitea (esta en .gitignore).

# Credenciales de la base (RAWDB / DM_DBA) — mismas que generar-imprimibles.
DB_USER=DM_DBA
DB_PASSWORD=changeme

# Bastion SSH.
SSH_BASTION=132.145.197.201
SSH_USER=ctgds

# Esta app NO trae su propia clave SSH ni su propio Oracle Instant Client
# (son pesados / sensibles): por defecto reusa los que ya tenes en
# generar-imprimibles. Ajusta estas dos rutas a donde tengas ese proyecto,
# o cambialas por una copia propia (keys/ctgds y oracle/instantclient_19_13
# dentro de esta carpeta) si preferis que sea autocontenido.
SSH_KEY_PATH=..\generar-imprimibles\keys\ctgds
ORACLE_CLIENT_LIB=..\generar-imprimibles\oracle\instantclient_19_13

# Carpeta con los .jrxml de los imprimibles (pestaña "Imprimibles -> vistas").
# No requiere conexion a la base, solo lee archivos locales.
PRINTOUTS_DIR=..\INSOR\shared_workspace\PRINTOUTS\FASE_1
